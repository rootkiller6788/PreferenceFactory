  "candidates": {
    "n_candidates": 3,
    "_families_note": [
      "kind_bonus 让每个族各有擅长与短板。没有它的话，能力最强的族在所有题型上都赢，",
      "「它产出的候选更差」的样本数为 0，自我偏好这条轴根本测不出来。",
      "三个「裁判归属族」（plain/careful/terse）的 verbosity 刻意接近（1.00/1.10/0.85），",
      "verbose（1.95）不给任何裁判 —— 它只负责提供长度方差。"
    ]
  },
  "judging": {
    "tie_margin": 0.05,
    "confidence_scale": 0.6,
    "weight_by_bias": true
  },
  "probes": {
    "n_swap": 96,
    "n_length": 96,
    "n_self": 96,
    "match_tolerance": 0.1,
    "trap_gap_lo": 0.08,
